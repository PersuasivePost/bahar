# WAQI ground-station token (free): https://aqicn.org/data-platform/token/
WAQI_TOKEN=
# Contact email put in the Nominatim User-Agent (required by their usage policy)
NOMINATIM_EMAIL=
# OpenAQ v3 key (optional, fallback station source)
OPENAQ_API_KEY=
# GGUF model; swap in the fine-tuned repo/file without code changes
MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# diskcache directory (static geography 7 d, weather/AQ <= 15 min)
CACHE_DIR=.cache
# Absolute base URL used to build map_url, e.g. the Cloudflare tunnel URL
PUBLIC_BASE_URL=http://localhost:7860
# Thread count (default: CPU affinity / cgroup quota). On SMT machines use physical cores.
N_THREADS=8
# /ask requests per client IP per minute
RATE_LIMIT_PER_MIN=10
